# Paperclip API
PAPERCLIP_API_URL=http://localhost:3000
PAPERCLIP_API_KEY=your-api-key-here
PAPERCLIP_COMPANY_ID=your-company-id

# Mimir API
MIMIR_API_URL=https://api.allinmimir.com
MIMIR_API_KEY=your-mimir-api-key-here
MIMIR_USER_ID=system

# Feishu OAuth
FEISHU_APP_ID=your-feishu-app-id
FEISHU_APP_SECRET=your-feishu-app-secret
NEXTAUTH_SECRET=your-session-secret
NEXTAUTH_URL=https://dash.ssgaccelerator.com
# Comma-separated Feishu open IDs or emails that should receive board access.
# When omitted, authenticated users default to employee access.
BOARD_FEISHU_OPEN_IDS=

# Supabase business data layer
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DASH_SYNC_API_KEY=your-shared-dash-sync-bearer-token
POSTGRES_URL="postgres://postgres.your-project-ref:password@your-pooler-host:6543/postgres?sslmode=require"
POSTGRES_URL_NON_POOLING="postgres://postgres.your-project-ref:password@your-host:5432/postgres?sslmode=require"
POSTGRES_HOST=db.your-project-ref.supabase.co
POSTGRES_DATABASE=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password

# OpenClaw feishu-bot runtime
# Point the EC2-B runtime at the deployed dashboard origin and reuse the same
# DASH_SYNC_API_KEY so the workspace-local dash_sync tool can authenticate.
SSGLAB_API_URL=https://dash.ssgaccelerator.com
