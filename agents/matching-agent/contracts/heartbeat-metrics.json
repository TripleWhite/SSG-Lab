{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HeartbeatMetrics",
  "description": "Metrics reported at the end of each matching agent heartbeat.",
  "type": "object",
  "properties": {
    "new_content_processed": { "type": "integer" },
    "matches_found": { "type": "integer" },
    "by_type": {
      "type": "object",
      "properties": {
        "supply-demand": { "type": "integer" },
        "resource": { "type": "integer" },
        "talent": { "type": "integer" },
        "investor": { "type": "integer" },
        "cross-project": { "type": "integer" },
        "mentor": { "type": "integer" }
      }
    },
    "by_confidence": {
      "type": "object",
      "properties": {
        "HIGH": { "type": "integer" },
        "MEDIUM": { "type": "integer" }
      }
    },
    "skipped_dedup": { "type": "integer" },
    "skipped_low_confidence": { "type": "integer" }
  },
  "required": ["new_content_processed", "matches_found"]
}
