{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ssglab.local/portfolio-agent/contracts/feishu-notify.schema.json",
  "title": "PortfolioFeishuNotifyPayload",
  "type": "object",
  "additionalProperties": false,
  "required": ["channel", "target", "type", "data"],
  "properties": {
    "channel": {
      "type": "string",
      "const": "feishu"
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "const": "portfolio_update"
    },
    "data": {
      "oneOf": [
        {
          "$ref": "#/$defs/dailyDigest"
        },
        {
          "$ref": "#/$defs/urgentAlert"
        },
        {
          "$ref": "#/$defs/boardSummary"
        }
      ]
    }
  },
  "$defs": {
    "button": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "label"],
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "schedule_followup",
            "snooze_1_week",
            "mark_complete",
            "view_plan",
            "modify_plan",
            "discuss",
            "view_dashboard",
            "details"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "portfolioItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "project_name",
        "summary",
        "recommendation"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "project_name": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "health": {
          "type": "string",
          "enum": [
            "on_track",
            "needs_attention",
            "at_risk",
            "overdue",
            "blocked"
          ]
        },
        "owner": {
          "type": "string"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "recommendation": {
          "type": "string",
          "minLength": 1
        },
        "resource": {
          "type": "string"
        },
        "due_at": {
          "type": "string",
          "format": "date-time"
        },
        "plan_steps": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "actions": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/button"
          }
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "priority", "items"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "type": "string",
          "enum": ["urgent", "high", "normal", "info"]
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/portfolioItem"
          }
        }
      }
    },
    "dailyDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "generated_at",
        "employee_name",
        "active_project_count",
        "sections",
        "buttons"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "daily_digest"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "employee_name": {
          "type": "string",
          "minLength": 1
        },
        "active_project_count": {
          "type": "integer",
          "minimum": 0
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/section"
          }
        },
        "buttons": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/button"
          }
        }
      }
    },
    "urgentAlert": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "generated_at",
        "alert_reason",
        "item",
        "buttons"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "urgent_alert"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "alert_reason": {
          "type": "string",
          "minLength": 1
        },
        "item": {
          "$ref": "#/$defs/portfolioItem"
        },
        "buttons": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/button"
          }
        }
      }
    },
    "boardAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_name", "owner", "summary"],
      "properties": {
        "project_id": {
          "type": "string"
        },
        "project_name": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "type": "string"
        },
        "health": {
          "type": "string",
          "enum": [
            "on_track",
            "needs_attention",
            "at_risk",
            "overdue",
            "blocked"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "boardSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "generated_at",
        "headline",
        "stage_counts",
        "health_counts",
        "top_actions",
        "buttons"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "board_summary"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "headline": {
          "type": "string",
          "minLength": 1
        },
        "stage_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contact",
            "diligence",
            "decision",
            "acceleration",
            "exit"
          ],
          "properties": {
            "contact": {
              "type": "integer",
              "minimum": 0
            },
            "diligence": {
              "type": "integer",
              "minimum": 0
            },
            "decision": {
              "type": "integer",
              "minimum": 0
            },
            "acceleration": {
              "type": "integer",
              "minimum": 0
            },
            "exit": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "health_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "on_track",
            "needs_attention",
            "at_risk",
            "overdue",
            "blocked"
          ],
          "properties": {
            "on_track": {
              "type": "integer",
              "minimum": 0
            },
            "needs_attention": {
              "type": "integer",
              "minimum": 0
            },
            "at_risk": {
              "type": "integer",
              "minimum": 0
            },
            "overdue": {
              "type": "integer",
              "minimum": 0
            },
            "blocked": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "top_actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/boardAction"
          }
        },
        "buttons": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/button"
          }
        }
      }
    }
  }
}
